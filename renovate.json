{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests"
  ],
  "ignorePaths": [
    ".github/"
  ],
  "timezone": "Europe/Paris",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "enabled": true,
      "schedule": [
        "* * * * 1-5"
      ],
      "labels": [
        "renovate",
        "npm"
      ],
      "ignorePaths": [
        "**/test*/**",
        "**/Test*/**",
        "**/lighthouse/**",
        ".github/"
      ],
      "rangeStrategy": "bump",
      "commitMessageSuffix": "[JS]"
    }
  ],
  "postUpgradeTasks": {
    "postUpdateOptions": [
      "pnpmDedupe"
    ]
  }
}
